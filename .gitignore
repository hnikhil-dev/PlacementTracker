# ==============================================================================
# SMART PLACEMENT TRACKER — Git Ignore Rules
# ==============================================================================

# Local Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*
!.env.example

# Python Virtual Environments & Packages
.venv/
env/
venv/
ENV/
*.venv
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# IDE & Editor Configurations
.cursor/
.vscode/
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.factorypath

# Scratch & Temporary Testing Scripts
scratch/
*.log
npm-debug.log*
*.tmp
*.bak

# OS Temporary Files
.DS_Store
Thumbs.db

# Archives & Builds
*.zip
*.tar.gz
*.rar
dist/
build/
coverage/

# Legacy Folders (Java / Node)
node_modules/
placement-tracker-springboot/
target/
*.class
out/
jdk-17/
bin/
