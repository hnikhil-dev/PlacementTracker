# ==============================================================================
# SMART PLACEMENT TRACKER — Environment Configuration (.env)
# ==============================================================================
# 📝 INSTRUCTIONS:
# 1. If not already created, copy this file and save it as: .env
#    (On Windows, running "run.bat" will automatically create .env for you!)
# 2. Replace the placeholder values (<...>) below with your actual Supabase keys.
# 3. Save the file and run "run.bat" (Windows) or "./run.sh" (macOS/Linux).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# How to get this:
# 1. Log in to your Supabase project (https://supabase.com/dashboard)
# 2. Go to: Project Settings (gear icon in left sidebar) -> Database
# 3. Scroll down to "Connection string" -> Select "URI" tab
# 4. Copy the URI and replace [YOUR-PASSWORD] with the database password you chose.
#
# Standard Format (Direct):
# DATABASE_URL=postgresql://postgres:<your-password>@db.<project-ref>.supabase.co:5432/postgres
#
# Pooler Format (Recommended for cloud networks):
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:<your-password>@db.<project-ref>.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. SUPABASE API CREDENTIALS (REQUIRED FOR RESUME STORAGE)
# ------------------------------------------------------------------------------
# How to get these:
# 1. Go to: Project Settings (gear icon) -> API
# 2. Copy "Project URL" -> paste below as SUPABASE_URL
# 3. Copy "anon public" key OR "service_role" secret -> paste below as SUPABASE_KEY
# 4. Go to: Storage (left sidebar) -> New Bucket -> Name it "resumes" -> Set Public: ON
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-service-role-key>
SUPABASE_BUCKET=resumes

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRET
# ------------------------------------------------------------------------------
# Used to sign secure student and admin login tokens (minimum 32 characters).
# You can use the secure pre-generated key below or replace it with your own:
JWT_SECRET=placement_tracker_jwt_super_secure_random_production_key_2026_xyz987

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI API (OPTIONAL)
# ------------------------------------------------------------------------------
# Used for AI mock interview questions and 30-day personalized learning roadmaps.
# Free API Key available at: https://aistudio.google.com/app/apikey
# NOTE: If left blank or quota exceeded, the system automatically uses the
# built-in offline question bank for 15+ major programming technologies!
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS (OPTIONAL - FOR PASSWORD RESETS)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ==============================================================================
# 🚀 CLIENT FIRST-TIME SETUP CHECKLIST:
# ==============================================================================
# [ ] 1. Create a free Supabase project at https://supabase.com
# [ ] 2. Copy your Database Connection URI into DATABASE_URL above
# [ ] 3. Copy your Project URL and API Key into SUPABASE_URL & SUPABASE_KEY
# [ ] 4. In Supabase Storage, create a public bucket named "resumes"
# [ ] 5. Double-click "run.bat"
#       -> Automatically installs Python (if missing)
#       -> Automatically creates virtual environment (.venv)
#       -> Automatically creates all database tables, 160+ skills, and admin account
#       -> Opens http://localhost:3000 in your browser!
# ==============================================================================
